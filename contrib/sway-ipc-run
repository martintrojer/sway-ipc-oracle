# Commands are deliberately conservative: every entry is accepted by sway 1.12,
# and state-dependent failures are useful command-reply observations.
COMMANDS = (
    "splith", "splitv", "layout splith", "layout splitv", "layout tabbed",
    "layout stacking", "focus left", "focus right", "focus up", "focus down",
    "focus parent", "focus child", "move left", "move right", "move up",
    "move down", "resize grow width 10 px", "resize shrink height 10 px",
    "floating toggle", "fullscreen toggle", "mark oracle", "unmark oracle",
    "workspace 1", "workspace 2", "workspace oracle", "scratchpad show",
    "move scratchpad", "sticky toggle", "move container to workspace 1",
    "move container to workspace 2", "kill",
)


def generate_commands(seed, steps):
    """Return a reproducible sequence of sway command strings."""
    rng = random.Random(seed)
    commands, next_window = [
        "exec foot --app-id=fixture-diff-1 --title=fixture-diff-1 sh -c 'sleep 300'"
    ], 2
    for _ in range(max(0, steps - 1)):
        if rng.random() < 0.22:
            ident = f"fixture-diff-{next_window}"
            next_window += 1
            commands.append(
                f"exec foot --app-id={ident} --title={ident} sh -c 'sleep 300'"
            )
        else:
            commands.append(rng.choice(COMMANDS))
    return commands


def minimize_commands(commands, reproduces):
    """Delta-debug COMMANDS to a 1-minimal reproducing subsequence."""
    current, chunks = list(commands), 2
    while len(current) >= 2:
        size = (len(current) + chunks - 1) // chunks
        reduced = False
        for start in range(0, len(current), size):
            candidate = current[:start] + current[start + size:]
            if candidate and reproduces(candidate):
                current, chunks, reduced = candidate, max(chunks - 1, 2), True
                break
        if not reduced:
            if chunks >= len(current):
                break
            chunks = min(len(current), chunks * 2)
    return current


def ipc(sock_path, kind, payload=""):
    body = payload.encode()
    with socket.socket(socket.AF_UNIX) as stream:
        stream.settimeout(5)
        stream.connect(os.fspath(sock_path))
        stream.sendall(MAGIC + struct.pack("=II", len(body), TYPES[kind]) + body)
        header = recv_exact(stream, 14)
        if header[:6] != MAGIC:
            raise RuntimeError("invalid IPC magic")
        length, reply_type = struct.unpack("=II", header[6:])
        if reply_type != TYPES[kind]:
            raise RuntimeError(f"IPC type {reply_type}, expected {TYPES[kind]}")
        return json.loads(recv_exact(stream, length))


def recv_exact(stream, length):
    chunks = []
    while length:
        chunk = stream.recv(length)
        if not chunk:
            raise RuntimeError("IPC connection closed before reply")
        chunks.append(chunk)
        length -= len(chunk)
    return b"".join(chunks)


def subscribed_event(sock_path, family, trigger):
    stream = socket.socket(socket.AF_UNIX)
    stream.settimeout(8)
    stream.connect(os.fspath(sock_path))
    body = json.dumps([family]).encode()
    stream.sendall(MAGIC + struct.pack("=II", len(body), TYPES["subscribe"]) + body)
    header = recv_exact(stream, 14)
    length, reply_type = struct.unpack("=II", header[6:])
    reply = json.loads(recv_exact(stream, length))
    if reply_type != TYPES["subscribe"] or not reply.get("success"):
        raise RuntimeError(f"subscription failed: {reply}")
    trigger()
    header = recv_exact(stream, 14)
    length, reply_type = struct.unpack("=II", header[6:])
    event = json.loads(recv_exact(stream, length))
    stream.close()
    if not reply_type & (1 << 31):
        raise RuntimeError(f"expected event, got IPC type {reply_type}")
    return event


def command(sock_path, text):
    reply = ipc(sock_path, "command", text)
    if not isinstance(reply, list) or not all(item.get("success") for item in reply):
        raise RuntimeError(f"command failed: {text}: {reply}")


def fixture_window_count(value):
    if not isinstance(value, dict):
        return 0
    identity = value.get("app_id") or (value.get("window_properties") or {}).get("instance", "")
    return int(str(identity).startswith("fixture-")) + sum(
        fixture_window_count(child)
        for key in ("nodes", "floating_nodes")
        for child in value.get(key, [])
    )


def wait_for(predicate, message, seconds=8):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        value = predicate()
        if value:
            return value
        time.sleep(0.05)
    raise RuntimeError(f"timed out waiting for {message}")


def load_rules():
    with open(ROOT / "sway-ipc/normalize.toml", "rb") as file:
        return tomllib.load(file)


def rule_names(rules):
    names = []
    for value in rules.values():
        entries = value if isinstance(value, list) else [value]
        names.extend(entry["name"] for entry in entries
                     if isinstance(entry, dict) and "name" in entry)
    return names


def tree_field_rules(rules, field, action=None):
    return [rule for rule in rules["tree_field_rule"]
            if rule["field"] == field and (action is None or rule["action"] == action)]


def rule_matches(rule, value):
    return all(value.get(key) == expected
               for key, expected in rule.get("selector", {}).items())


def difference_path(difference):
    return difference.split(":", 1)[0]


def load_applicability():
    with open(ROOT / "sway-ipc/applicability.toml", "rb") as file:
        return tomllib.load(file)


def i3_protocol_view(expected, actual, request, applicability):
    fields = set(applicability["i3"][request]["fields"])
    excluded = set()

    def project(value, collect=False, protocol_object=True):
        if isinstance(value, dict):
            if not protocol_object:
                return copy.deepcopy(value)
            if collect:
                excluded.update(value.keys() - fields)
            return {
                key: project(child, collect, key in ("nodes", "floating_nodes"))
                for key, child in value.items()
                if key in fields
            }
        if isinstance(value, list):
            return [project(child, collect, protocol_object) for child in value]
        return value

    return project(expected, True), project(actual), sorted(excluded)


def normalize(value, rules, path="$", is_output=False):
    if isinstance(value, dict):
        output = value.get("type") == "output"
        ignored = {key for rule in rules["ignore_key"] for key in rule["keys"]}
        output_ignored = {key for rule in rules["ignore_output_key"] for key in rule["keys"]}
        suffixes = tuple(suffix for rule in rules["ignore_path"] for suffix in rule["suffixes"])
        conditional_ignores = [rule for rule in rules["tree_field_rule"]
                               if rule["action"] == "ignore" and rule_matches(rule, value)]
        for key, child in value.items():
            child_path = f"{path}.{key}"
            if (key in ignored or (output and key in output_ignored)
                    or child_path.endswith(suffixes)
                    or any(rule["field"] == key for rule in conditional_ignores)):
                value[key] = NORMAL
            else:
                normalize(child, rules, child_path, output)
    elif isinstance(value, list):
        for index, child in enumerate(value):
            normalize(child, rules, f"{path}[{index}]", is_output)


def diff_values(expected, actual, path, differences, ignored_array_suffixes, numeric_tolerances):
    if type(expected) is not type(actual):
        differences.append(f"{path}: type {type(expected).__name__} != {type(actual).__name__}")
    elif isinstance(expected, dict):
        if expected.keys() != actual.keys():
            differences.append(f"{path}: keys differ")
        for key in expected.keys() & actual.keys():
            diff_values(expected[key], actual[key], f"{path}.{key}", differences,
                        ignored_array_suffixes, numeric_tolerances)
    elif isinstance(expected, list):
        if not path.endswith(ignored_array_suffixes) and len(expected) != len(actual):
            differences.append(f"{path}: length {len(expected)} != {len(actual)}")
        for index, (left, right) in enumerate(zip(expected, actual)):
            diff_values(left, right, f"{path}[{index}]", differences,
                        ignored_array_suffixes, numeric_tolerances)
    elif expected != actual:
        tolerance = next((value for suffix, value in numeric_tolerances
                          if path.endswith(suffix)), None)
        if (tolerance is None or not isinstance(expected, (int, float))
                or not isinstance(actual, (int, float))
                or abs(expected - actual) >= tolerance):
            differences.append(f"{path}: {expected!r} != {actual!r}")


def tree_pairs(expected, actual, path="$tree"):
    yield expected, actual, path
    for key in ("nodes", "floating_nodes"):
        for index, pair in enumerate(zip(expected.get(key, []), actual.get(key, []))):
            yield from tree_pairs(*pair, f"{path}.{key}[{index}]")


def semantic_tree_diffs(expected, actual, rules):
    differences = []
    rect_rule = tree_field_rules(rules, "rect", "rect_tolerance")[0]
    percent_rule = tree_field_rules(rules, "percent", "numeric_tolerance")[0]
    rect_ignores = tree_field_rules(rules, "rect", "ignore")
    percent_ignores = tree_field_rules(rules, "percent", "ignore")
    tolerance = rect_rule["tolerance"]
    epsilon = percent_rule["tolerance"]
    for left, right, path in tree_pairs(expected, actual):
        if not any(rule_matches(rule, left) for rule in rect_ignores):
            for key in ("x", "y", "width", "height"):
                if abs(left["rect"][key] - right["rect"][key]) > tolerance:
                    differences.append(f"{path}.rect.{key}: outside {tolerance}px tolerance")
        expected_children = left.get("nodes", []) + left.get("floating_nodes", [])
        actual_children = right.get("nodes", []) + right.get("floating_nodes", [])
        mapping = {a.get("id"): b.get("id") for a, b in zip(expected_children, actual_children)}
        mapped_focus = [mapping[item] for item in left.get("focus", []) if item in mapping]
        actual_ids = {child.get("id") for child in actual_children}
        actual_focus = [item for item in right.get("focus", []) if item in actual_ids]
        if mapped_focus != actual_focus:
            differences.append(f"{path}.focus: child-position order differs")
        if not any(rule_matches(rule, left) for rule in percent_ignores):
            lp, rp = left.get("percent"), right.get("percent")
            if ((lp is None) != (rp is None)
                    or (lp is not None and (not isinstance(lp, (int, float))
                        or not isinstance(rp, (int, float)) or abs(lp - rp) >= epsilon))):
                differences.append(f"{path}.percent: differs")
        if left.get("type") == "con" and not left.get("nodes"):
            for role in ("window_rect", "deco_rect", "geometry"):
                if (left.get(role) == left.get("rect")) != (right.get(role) == right.get("rect")):
                    differences.append(f"{path}.{role}: outer-rect relationship differs")
            if (left["deco_rect"]["height"] > 0) != (right["deco_rect"]["height"] > 0):
                differences.append(f"{path}.deco_rect: titlebar presence differs")
    return differences


def compare(expected, actual, request, rules):
    differences = []
    ignored = tuple(rules["arrays"]["ignore_length_suffixes"])
    left, right = copy.deepcopy(expected), copy.deepcopy(actual)
    normalize(left, rules, f"${request}")
    normalize(right, rules, f"${request}")
    numeric_tolerances = [(f".{rule['field']}", rule["tolerance"])
                          for rule in rules["tree_field_rule"]
                          if rule["action"] == "numeric_tolerance"]
    diff_values(left, right, f"${request}", differences, ignored, numeric_tolerances)
    if request == "tree" and not differences:
        differences.extend(semantic_tree_diffs(expected, actual, rules))
    return list(dict.fromkeys(differences))


class Adapter:
    def __init__(self, args, run_dir, scenario=None):
        self.args, self.run_dir, self.scenario = args, run_dir, scenario or {}
        self.socket = run_dir / "ipc.sock"
        self.process = None
        self.env = os.environ.copy()
        for name in ("SWAYSOCK", "I3SOCK", "WAYLAND_DISPLAY", "DISPLAY"):
            self.env.pop(name, None)

    def wrapped(self, command):
        return ["systemd-run", "--user", "--scope", "--quiet", "-p", "MemoryMax=2G", "-p", "MemorySwapMax=0", "timeout", str(self.args.timeout), *command]

    def start_process(self, command, log):
        runtime = self.env.pop("XDG_RUNTIME_DIR", None)
        if runtime:
            command = ["env", f"XDG_RUNTIME_DIR={runtime}", *command]
        self.process = subprocess.Popen(self.wrapped(command), env=self.env, stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
        wait_for(lambda: self.socket.exists() or self.process.poll() is not None, "private IPC socket")
        if self.process.poll() is not None:
            raise RuntimeError(f"compositor exited with {self.process.returncode}")

    def stop(self):
        if self.process and self.process.poll() is None:
            os.killpg(self.process.pid, signal.SIGTERM)
            try:
                self.process.wait(3)
            except subprocess.TimeoutExpired:
                os.killpg(self.process.pid, signal.SIGKILL)
                self.process.wait()

    def command_reply(self, text):
        return ipc(self.socket, "command", text)

    def run_command(self, text):
        reply = self.command_reply(text)
        if not isinstance(reply, list) or not all(item.get("success") for item in reply):
            raise RuntimeError(f"command failed: {text}: {reply}")

    def reset(self):
        reply = ipc(self.socket, "command", '[app_id="^fixture-"] kill')
        if not isinstance(reply, list) or not all(item.get("success") or item.get("error") == "No matching node." for item in reply):
            raise RuntimeError(f"fixture cleanup failed: {reply}")
        wait_for(lambda: fixture_window_count(ipc(self.socket, "tree")) == 0, "fixture windows to close")
        self.run_command("workspace __fixture_reset")
        self.run_command("workspace 1")

    def open_window(self, ident):
        raise NotImplementedError


class WaylandAdapter(Adapter):
    config_text = ""

    def rendered_config(self):
        return self.config_text

    def start(self, log):
        config = self.run_dir / self.config_name
        config.write_text(self.rendered_config())
        self.env.update({"WLR_BACKENDS": "headless", "WLR_HEADLESS_OUTPUTS": str(self.scenario.get("outputs", 1)), "SWAYSOCK": str(self.socket), "XDG_RUNTIME_DIR": str(self.run_dir)})
        self.start_process([str(self.args.binary), "-c", str(config)], log)
        version = ipc(self.socket, "version")
        self.display = wait_for(self.find_display, "private Wayland socket")
        return version

    def find_display(self):
        sockets = [path for path in self.run_dir.glob("wayland-*") if not path.name.endswith(".lock")]
        return sockets[0].name if sockets else None

    def open_window(self, ident, title=None):
        before = fixture_window_count(ipc(self.socket, "tree"))
        title = title or ident
        command(self.socket, f"exec foot --app-id={shlex.quote(ident)} --title={shlex.quote(title)} sh -c 'sleep 300'")
        wait_for(lambda: fixture_window_count(ipc(self.socket, "tree")) == before + 1, ident)


class SwayAdapter(WaylandAdapter):
    config_name = "config"
    config_text = "font monospace 10\ndefault_border normal 2\noutput * mode 1270x1408\noutput * bg #000000 solid_color\nmode resize {\n    bindsym Escape mode default\n}\nbindsym Shift+Ctrl+t nop\n"

    @staticmethod
    def version_details(reply):
        version = reply.get("human_readable", "unknown")
        target = json.loads((FIXTURES / "schema-version.json").read_text())
        commit = target["commit"] if target["version"] in version else "unknown"
        return version, commit


class SwaywardAdapter(WaylandAdapter):
    config_name = "config.kdl"
    config_text = "layout { default-orientation \"vertical\"; default-border \"normal\" width=2; default-floating-border \"normal\" width=2; border { on; width 2; }; }\n"

    def rendered_config(self):
        outputs = (
            f'output "headless-{number}" {{ mode custom=true "1270x1408@60"; scale 1; }}\n'
            for number in range(1, self.scenario.get("outputs", 1) + 1)
        )
        return "".join(outputs) + self.config_text

    @staticmethod
    def version_details(reply):
        version = reply.get("human_readable", "unknown")
        commit = next((part.rsplit("g", 1)[-1].rstrip(")") for part in version.split() if "-g" in part), "unknown")
        return version, commit

    def start(self, log):
        config = self.run_dir / self.config_name
        config.write_text(self.rendered_config())
        self.env.update({"WLR_HEADLESS_OUTPUTS": str(self.scenario.get("outputs", 1)), "SWAYSOCK": str(self.socket), "I3SOCK": str(self.socket), "XDG_RUNTIME_DIR": str(self.run_dir)})
        self.start_process([str(self.args.binary), "-c", str(config)], log)
        version = ipc(self.socket, "version")
        self.display = wait_for(self.find_display, "private Wayland socket")
        return version


class I3Adapter(Adapter):
    def start(self, log):
        if not shutil.which("Xvfb") or not shutil.which("xterm"):
            raise RuntimeError("i3 adapter requires Xvfb and xterm")
        display_number = next((number for number in range(200, 700) if not Path(f"/tmp/.X11-unix/X{number}").exists()), None)
        if display_number is None:
            raise RuntimeError("no private X display number available")
        self.display = f":{display_number}"
        config = self.run_dir / "config"
        config.write_text(f"font pango:monospace 10\nipc-socket {self.socket}\ndefault_border normal 2\n")
        self.env["DISPLAY"] = self.display
        script = f'exec Xvfb {self.display} -screen 0 1270x1408x24 & xvfb=$!; trap "kill $xvfb" EXIT; for i in $(seq 1 100); do [ -S /tmp/.X11-unix/X{display_number} ] && break; sleep .05; done; {self.args.binary} -c {config}'
        self.start_process(["sh", "-c", script], log)
        return ipc(self.socket, "version")

    @staticmethod
    def version_details(reply):
        version = reply.get("human_readable", "unknown")
        commit = version.rsplit("g", 1)[-1] if "-g" in version else "unknown"
        return version, commit

    def run_command(self, text):
        command(self.socket, text.replace("app_id=", "instance="))

    def reset(self):
        reply = ipc(self.socket, "command", '[instance="^fixture-"] kill')
        if not isinstance(reply, list) or not all(item.get("success") or item.get("error") == "No matching node." for item in reply):
            raise RuntimeError(f"fixture cleanup failed: {reply}")
        wait_for(lambda: fixture_window_count(ipc(self.socket, "tree")) == 0, "fixture windows to close")
        self.run_command("workspace fixture-reset")
        self.run_command("workspace 1")

    def open_window(self, ident, title=None):
        before = fixture_window_count(ipc(self.socket, "tree"))
        title = title or ident
        self.run_command(f"exec --no-startup-id xterm -name {shlex.quote(ident)} -title {shlex.quote(title)}")
        wait_for(lambda: fixture_window_count(ipc(self.socket, "tree")) == before + 1, ident)


ADAPTERS = {"sway": SwayAdapter, "swayward": SwaywardAdapter, "i3": I3Adapter}
DIFFERENTIAL_CONFIGS = {
    "sway": "font monospace 10\ndefault_border normal 2\noutput * mode 1280x720\noutput * bg #000000 solid_color\n",
    "swayward": "output \"headless-1\" { mode custom=true \"1280x720@60\"; scale 1; }\nlayout { default-orientation \"horizontal\"; default-border \"normal\" width=2; default-floating-border \"normal\" width=2; border { on; width 2; }; }\n",
}


def differential_action(adapter, text):
    before = fixture_window_count(ipc(adapter.socket, "tree"))
    reply = adapter.command_reply(text)
    if text.startswith("exec foot --app-id=") and reply and reply[0].get("success"):
        wait_for(lambda: fixture_window_count(ipc(adapter.socket, "tree")) > before,
                 "generated window")
    else:
        time.sleep(0.03)
    return reply


def differential_once(args, commands, keep_state=False):
    """Run one sequence on fresh compositors and return its first divergence."""
    with tempfile.TemporaryDirectory(prefix="sway-ipc-differential-") as directory:
        base = Path(directory)
        adapters = []
        versions = []
        logs = []
        try:
            for label, compositor, binary in (
                ("a", args.a, args.a_binary), ("b", args.b, args.b_binary)
            ):
                run_dir = base / label
                run_dir.mkdir()
                adapter_args = argparse.Namespace(binary=binary, timeout=args.timeout)
                adapter = ADAPTERS[compositor](adapter_args, run_dir)
                if compositor in DIFFERENTIAL_CONFIGS:
                    adapter.config_text = DIFFERENTIAL_CONFIGS[compositor]
                log = open(run_dir / "compositor.log", "w")
                logs.append(log)
                versions.append(adapter.start(log))
                adapters.append(adapter)
                reply = adapter.command_reply("output * mode --custom 1280x720@60Hz")
                if not reply or not reply[0].get("success"):
                    raise RuntimeError(f"could not set differential output mode: {reply}")
            rules = load_rules()
            for step, text in enumerate(commands, 1):
                replies = [differential_action(adapter, text) for adapter in adapters]
                observations = {"command": replies}
                for request in ("tree", "workspaces"):
                    observations[request] = [ipc(adapter.socket, request) for adapter in adapters]
                for request, pair in observations.items():
                    differences = compare(pair[0], pair[1], request, rules)
                    if differences:
                        result = {
                            "step": step, "command": text, "request": request,
                            "differences": differences,
                        }
                        if keep_state:
                            result["sway_state"] = {
                                "command": observations["command"][0],
                                "tree": observations["tree"][0],
                                "workspaces": observations["workspaces"][0],
                                "outputs": ipc(adapters[0].socket, "outputs"),
                            }
                        return result, versions
            return None, versions
        finally:
            for adapter in reversed(adapters):
                adapter.stop()
            for log in logs:
                log.close()


def append_regression_scenario(seed, commands, state):
    name = f"differential_seed_{seed}"
    scenario_path = ROOT / "sway-ipc/scenarios.toml"
    existing = tomllib.loads(scenario_path.read_text())["scenario"]
    if name not in {item["name"] for item in existing}:
        actions = []
        for index, text in enumerate(commands):
            if text.startswith("exec foot --app-id=fixture-diff-"):
                ident = text.split("--app-id=", 1)[1].split(" ", 1)[0]
                actions.append(f"window:{ident}")
            elif index == len(commands) - 1:
                actions.append(f"probe:{name}:{text}")
            else:
                actions.append(f"step:{text}")
        actions.append(f"capture:{name}")
        with open(scenario_path, "a") as file:
            file.write(f"\n[[scenario]]\nname = {toml_string(name)}\n")
            file.write("actions = [" + ", ".join(toml_string(item) for item in actions) + "]\n")
    has_probe = any(action.startswith(f"probe:{name}:") for action in actions)
    for request, value in state.items():
        if request == "command" and not has_probe:
            continue
        (FIXTURES / f"{name}.{request}.json").write_text(
            json.dumps(value, indent=2, sort_keys=True) + "\n"
        )
    return name


def capture_individual_events(adapter):
    events = FIXTURES / "events"

    def save(family, change, trigger):
        event = subscribed_event(adapter.socket, family, trigger)
        if event.get("change") != change:
            raise RuntimeError(f"expected {family}::{change}, got {event.get('change')}")
        (events / f"{family}.{change}.json").write_text(json.dumps(event, indent=2, sort_keys=True) + "\n")

    adapter.reset()
    save("workspace", "reload", lambda: adapter.run_command("reload"))
    save("mode", "resize", lambda: adapter.run_command("mode resize"))
    save("mode", "default", lambda: adapter.run_command("mode default"))

    adapter.open_window("fixture-event-one")
    save("window", "floating", lambda: adapter.run_command("floating enable"))
    save("window", "fullscreen_mode", lambda: adapter.run_command("fullscreen enable"))
    save("window", "mark", lambda: adapter.run_command("mark eventmark"))
    save("window", "title", lambda: adapter.run_command("title_format event-title"))
    save("window", "move", lambda: adapter.run_command("move workspace 2"))
    adapter.run_command("workspace 1")
    save("workspace", "urgent", lambda: adapter.run_command('[app_id="^fixture-event-one$"] urgent enable'))
    save("window", "urgent", lambda: adapter.run_command('[app_id="^fixture-event-one$"] urgent disable, urgent enable'))
    save("workspace", "focus", lambda: adapter.run_command("workspace 2"))
    save("workspace", "rename", lambda: adapter.run_command("rename workspace 2 to event-renamed"))
    save("window", "close", lambda: adapter.run_command('[app_id="^fixture-event-one$"] kill'))


def shape_of(tree):
    """Keep layout semantics while dropping runtime identity and geometry."""
    def node(value):
        result = {
            key: value.get(key) for key in
            ("type", "layout", "orientation", "floating", "fullscreen_mode", "sticky")
            if key in value
        }
        result["nodes"] = [node(child) for child in value.get("nodes", [])]
        result["floating_nodes"] = [node(child) for child in value.get("floating_nodes", [])]
        return result
    return node(tree)


def load_i3_logs(directory):
    records = []
    for path in sorted(directory.glob("*.commands.jsonl")):
        for line in path.read_text().splitlines():
            if line.strip():
                records.append(json.loads(line))
    return records


def settled_state(adapter):
    previous = None
    for _ in range(40):
        state = {request: ipc(adapter.socket, request)
                 for request in ("tree", "workspaces", "outputs")}
        encoded = json.dumps(state, sort_keys=True)
        if encoded == previous:
            return state
        previous = encoded
        time.sleep(0.05)
    raise RuntimeError("i3-derived state did not settle")


def replay_i3_segment(adapter, records, capture, seen, scenarios, skips):
    actions = []
    for index, record in enumerate(records, 1):
        kind, value = record["kind"], record["value"]
        if kind == "command":
            session_bound = ("[id=", "[con_id=", "[class=", "[instance=",
                             "[title=", "[window_role=", "[window_type=")
            if (any(token in value for token in session_bound)
                    or value.strip() in ("restart", "exit")
                    or "exec " in value or "bar " in value):
                skips.append({"test": record["test"], "line": record["line"],
                              "reason": f"not replayable outside the originating X11 session: {value}"})
                break
        if kind == "window":
            ident = f"fixture-i3-{len(actions) + 1}"
            adapter.open_window(ident)
            time.sleep(0.15)
            actions.append({"kind": "window", "value": ident})
        elif kind == "command":
            adapter.command_reply(value)
            actions.append({"kind": "command", "value": value})
        else:
            continue
        try:
            state = settled_state(adapter)
        except OSError as error:
            skips.append({"test": record["test"], "line": record["line"],
                          "reason": f"replay terminated the compositor: {error}"})
            break
        shape = json.dumps(shape_of(state["tree"]), sort_keys=True, separators=(",", ":"))
        digest = hashlib.sha256(shape.encode()).hexdigest()[:16]
        if digest in seen:
            continue
        seen.add(digest)
        scenario = {
            "name": digest,
            "provenance": {"test": record["test"], "line": record["line"]},
            "actions": copy.deepcopy(actions),
        }
        scenarios.append(scenario)
        if capture:
            (I3_DERIVED / f"{digest}.json").write_text(
                json.dumps(state, sort_keys=True, separators=(",", ":")) + "\n"
            )


def i3_derived_main(args, parser):
    if args.binary is None or args.compositor is None:
        parser.error("i3-derived requires --compositor and --binary")
    if args.capture and args.compositor != "sway":
        parser.error("i3-derived capture is restricted to sway")
    manifest_path = I3_DERIVED / "scenarios.json"
    if args.capture:
        if args.command_logs is None:
            parser.error("i3-derived --capture requires --command-logs")
        I3_DERIVED.mkdir(parents=True, exist_ok=True)
        for path in I3_DERIVED.glob("*.json"):
            path.unlink()
        records = load_i3_logs(args.command_logs)
        scenarios, skips, seen, segment, segments = [], [], set(), [], []
        for record in records:
            if record["kind"] == "reset":
                if segment:
                    segments.append(segment)
                    segment = []
            else:
                segment.append(record)
        if segment:
            segments.append(segment)
        for segment in segments:
            with tempfile.TemporaryDirectory(prefix="sway-ipc-i3-derived-") as directory:
                adapter = ADAPTERS["sway"](args, Path(directory))
                with open(Path(directory) / "compositor.log", "w") as log:
                    try:
                        adapter.start(log)
                        replay_i3_segment(adapter, segment, True, seen, scenarios, skips)
                    finally:
                        adapter.stop()
        manifest = {
            "description": "States reached by i3's unchanged tests, captured from sway 1.12",
            "scenarios": scenarios, "skips": skips,
        }
        manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
        print(f"captured {len(scenarios)} distinct shapes; skipped {len(skips)} sequences")
        return 0

    manifest = json.loads(manifest_path.read_text())
    rules, rows = load_rules(), []
    for scenario in manifest["scenarios"]:
        with tempfile.TemporaryDirectory(prefix="sway-ipc-i3-derived-") as directory:
            adapter = ADAPTERS[args.compositor](args, Path(directory))
            with open(Path(directory) / "compositor.log", "w") as log:
                try:
                    version_reply = adapter.start(log)
                    for action in scenario["actions"]:
                        if action["kind"] == "window":
                            adapter.open_window(action["value"])
                            time.sleep(0.15)
                        else:
                            adapter.command_reply(action["value"])
                    actual = settled_state(adapter)
                finally:
                    adapter.stop()
        expected = json.loads((I3_DERIVED / f"{scenario['name']}.json").read_text())
        for request in ("tree", "workspaces", "outputs"):
            differences = compare(expected[request], actual[request], request, rules)
            rows.append({"scenario": f"i3-derived/{scenario['name']}", "request": request,
                         "verdict": "mismatch" if differences else "match",
                         "differences": differences})
    version, commit = adapter.version_details(version_reply)
    out = args.out or ROOT / f"sway-ipc/results/{args.compositor}-i3-derived.toml"
    counts, _ = write_results(out, args.compositor, version, commit, rows, rules,
                              "fresh compositor per derived i3 state")
    print("; ".join(f"{key}: {counts[key]}" for key in counts))
    return bool(counts.get("mismatch", 0))


def selected_scenarios(names):
    with open(ROOT / "sway-ipc/scenarios.toml", "rb") as file:
        scenarios = tomllib.load(file)["scenario"]
    if names:
        unknown = set(names) - {item["name"] for item in scenarios}
        if unknown:
            raise RuntimeError("unknown scenarios: " + ", ".join(sorted(unknown)))
        scenarios = [item for item in scenarios if item["name"] in names]
    return scenarios


def toml_string(value):
    return json.dumps(str(value), ensure_ascii=False)


def write_results(path, compositor, version, commit, rows, rules, run_mode):
    verdicts = ("match", "differs", "not applicable") if compositor == "i3" else ("match", "mismatch", "not applicable")
    counts = {key: sum(row["verdict"] == key for row in rows) for key in verdicts}
    difference_fields = len({difference_path(item) for row in rows
                             for item in row.get("differences", [])})
    lines = [
        "# Generated by contrib/sway-ipc-run. One row is one IPC request at a",
        "# captured scenario. Difference paths are JSON paths after documented normalization.",
        "# These rows describe where i3's IPC differs from sway's captures; they are not a pass rate." if compositor == "i3" else "# Every sway fixture field applies to this compositor's sway-compatibility claim.",
        "# Always report " + ", ".join(verdicts) + " together.",
        "",
        "[run]",
        f"compositor = {toml_string(compositor)}",
        f"version = {toml_string(version)}",
        f"commit = {toml_string(commit)}",
        f"oracle_commit = {toml_string(subprocess.check_output(['git', '-C', ROOT, 'rev-parse', 'HEAD'], text=True).strip())}",
        f"date = {toml_string(datetime.date.today().isoformat())}",
        'normalization = "sway-ipc/normalize.toml"',
        "normalization_rules = [" + ", ".join(toml_string(name) for name in rule_names(rules)) + "]",
        f"scenario_isolation = {toml_string(run_mode)}",
        f"difference_fields = {difference_fields}",
        *[f"{key.replace(' ', '_')} = {counts[key]}" for key in verdicts],
        "",
    ]
    for row in rows:
        lines += ["[[result]]", f"scenario = {toml_string(row['scenario'])}", f"request = {toml_string(row['request'])}", f"verdict = {toml_string(row['verdict'])}"]
        if row.get("differences"):
            lines.append("differences = [" + ", ".join(toml_string(item) for item in row["differences"]) + "]")
        if row.get("reason"):
            lines.append(f"reason = {toml_string(row['reason'])}")
        lines.append("")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines))
    return counts, difference_fields


def scenario_main(args, parser):
    if (args.capture or args.capture_events) and args.compositor != "sway":
        parser.error("capture is restricted to sway")
    if args.binary.resolve() == Path(sys.executable).resolve() or not args.binary.exists():
        parser.error("--binary must name an existing compositor")
    scenarios, rules, rows = selected_scenarios(args.scenario), load_rules(), []
    if args.capture_events:
        scenarios = []
    applicability = load_applicability()
    if args.capture_events:
        batches = [[{"outputs": 2}]]
    elif args.fresh_per_scenario:
        batches = [[scenario] for scenario in scenarios]
    else:
        ordinary = [scenario for scenario in scenarios if "outputs" not in scenario]
        batches = ([ordinary] if ordinary else []) + [[scenario] for scenario in scenarios if "outputs" in scenario]
    for batch in batches:
        with tempfile.TemporaryDirectory(prefix="sway-ipc-oracle-") as directory:
            run_dir = Path(directory)
            adapter = ADAPTERS[args.compositor](args, run_dir, batch[0] if len(batch) == 1 else None)
            with open(run_dir / "compositor.log", "w") as log:
                try:
                    version_reply = adapter.start(log)
                    if args.capture_events:
                        capture_individual_events(adapter)
                        batch = []
                    for scenario in batch:
                        if args.compositor not in scenario.get("compositors", ADAPTERS):
                            for action in scenario["actions"]:
                                kind, value = action.split(":", 1)
                                if kind == "capture":
                                    for request in ("tree", "workspaces", "outputs"):
                                        rows.append({"scenario": value, "request": request, "verdict": "not applicable", "reason": scenario["reason"]})
                            continue
                        adapter.reset()
                        for action in scenario["actions"]:
                            kind, value = action.split(":", 1)
                            if kind == "command":
                                adapter.run_command(value)
                            elif kind == "step":
                                adapter.command_reply(value)
                            elif kind == "probe":
                                fixture_name, text = value.split(":", 1)
                                actual = adapter.command_reply(text)
                                fixture = FIXTURES / f"{fixture_name}.command.json"
                                if args.capture:
                                    fixture.write_text(json.dumps(actual, indent=2, sort_keys=True) + "\n")
                                expected = json.loads(fixture.read_text())
                                differences = compare(expected, actual, "command", rules)
                                verdict = "differs" if args.compositor == "i3" and differences else "mismatch" if differences else "match"
                                rows.append({"scenario": fixture_name, "request": "command", "verdict": verdict, "differences": differences})
                            elif kind == "window":
                                adapter.open_window(value)
                            elif kind == "window_title":
                                ident, title = value.split("|", 1)
                                adapter.open_window(ident, title)
                            elif kind == "capture":
                                time.sleep(0.15)
                                for request in ("tree", "workspaces", "outputs"):
                                    actual = ipc(adapter.socket, request)
                                    fixture = FIXTURES / f"{value}.{request}.json"
                                    if args.capture:
                                        fixture.write_text(json.dumps(actual, indent=2, sort_keys=True) + "\n")
                                    expected = json.loads(fixture.read_text())
                                    excluded = []
                                    if args.compositor == "i3":
                                        expected, actual, excluded = i3_protocol_view(expected, actual, request, applicability)
                                    differences = compare(expected, actual, request, rules)
                                    verdict = "differs" if args.compositor == "i3" and differences else "mismatch" if differences else "match"
                                    rows.append({"scenario": value, "request": request, "verdict": verdict, "differences": differences})
                                    if excluded:
                                        source = applicability["i3"][request]["sway_extension_source"]
                                        rows.append({"scenario": value, "request": request, "verdict": "not applicable", "reason": f"sway extension fields: {', '.join(excluded)}; source: {source}"})
                            else:
                                raise RuntimeError(f"unknown action {kind}")
                finally:
                    adapter.stop()
    if hasattr(adapter, "version_details"):
        version, commit = adapter.version_details(version_reply)
    else:
        version = version_reply.get("human_readable", version_reply.get("loaded_config_file_name", "unknown"))
        commit = version_reply.get("commit", "unknown")
    out = args.out or ROOT / f"sway-ipc/results/{args.compositor}.toml"
    run_mode = "fresh compositor per scenario" if args.fresh_per_scenario else "sequential, with output-count scenarios isolated"
    counts, difference_fields = write_results(out, args.compositor, version, commit, rows, rules, run_mode)
    print("; ".join([*(f"{key}: {counts[key]}" for key in counts),
                     f"difference fields: {difference_fields}"]))
    return bool(counts.get("mismatch", 0))


def write_differential_results(path, args, rows):
    counts = {"match": sum(row["verdict"] == "match" for row in rows),
              "mismatch": sum(row["verdict"] == "mismatch" for row in rows)}
    rules = load_rules()
    difference_fields = len({difference_path(item) for row in rows
                             for item in row.get("differences", [])})
    grouped = []
    for row in rows:
        if row["verdict"] == "match":
            grouped.append(row)
            continue
        key = (tuple(row["commands"]), row["request"], tuple(row["differences"]))
        existing = next((item for item in grouped if item.get("key") == key), None)
        if existing:
            existing["seeds"].append(row["seed"])
        else:
            grouped.append({**row, "key": key, "seeds": [row["seed"]]})
    lines = [
        "# Generated by contrib/sway-ipc-run differential.",
        "# One row is one seed; match and mismatch counts are always shown together.",
        "# Mismatches contain delta-debugged reproducers and require triage.", "",
        "[run]", f"a = {toml_string(args.a)}", f"b = {toml_string(args.b)}",
        f"steps = {args.steps}", f"seeds = {len(rows)}",
        f"date = {toml_string(datetime.date.today().isoformat())}",
        'normalization = "sway-ipc/normalize.toml"',
        "normalization_rules = [" + ", ".join(toml_string(name) for name in rule_names(rules)) + "]",
        f"difference_fields = {difference_fields}",
        f"match = {counts['match']}", f"mismatch = {counts['mismatch']}", "",
    ]
    for row in grouped:
        lines += ["[[result]]", f"seed = {row['seed']}",
                  f"verdict = {toml_string(row['verdict'])}"]
        if row["verdict"] == "mismatch":
            lines += ["seeds = [" + ", ".join(str(seed) for seed in row["seeds"]) + "]",
                      f"step = {row['step']}", f"request = {toml_string(row['request'])}",
                      "commands = [" + ", ".join(toml_string(x) for x in row["commands"]) + "]",
                      "differences = [" + ", ".join(toml_string(x) for x in row["differences"]) + "]",
                      f"scenario = {toml_string(row['scenario'])}",
                      f"triage = {toml_string(args.triage)}"]
            if args.finding:
                lines.append(f"finding = {toml_string(args.finding)}")
            if args.source:
                lines.append(f"source = {toml_string(args.source)}")
        lines.append("")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines))
    print(f"match: {counts['match']}; mismatch: {counts['mismatch']}; "
          f"difference fields: {difference_fields}")
    return bool(counts["mismatch"])


def differential_main(args):
    if args.a_binary is None or args.b_binary is None:
        raise RuntimeError("differential requires --a-binary and --b-binary")
    rows = []
    for seed in range(args.seed, args.seed + args.seeds):
        commands = generate_commands(seed, args.steps)
        divergence, _ = differential_once(args, commands)
        if divergence is None:
            rows.append({"seed": seed, "verdict": "match"})
            continue
        def reproduces(candidate):
            found, _ = differential_once(args, candidate)
            return found is not None
        minimal = minimize_commands(commands[:divergence["step"]], reproduces)
        final, _ = differential_once(args, minimal, keep_state=True)
        if final is None:
            raise RuntimeError(f"seed {seed} stopped reproducing during shrink")
        scenario = f"differential_seed_{seed}"
        if args.save_scenarios:
            scenario = append_regression_scenario(seed, minimal, final["sway_state"])
        rows.append({"seed": seed, "verdict": "mismatch", "commands": minimal,
                     "scenario": scenario, **{k: final[k] for k in
                     ("step", "request", "differences")}})
    out = args.out or ROOT / "sway-ipc/results/differential-swayward.toml"
    return write_differential_results(out, args, rows)


def main():
    parser = argparse.ArgumentParser(
        description="Run, capture, or compare data-driven sway IPC scenarios."
    )
    parser.add_argument("mode", nargs="?", choices=("scenarios", "differential", "i3-derived"), default="scenarios")
    parser.add_argument("--compositor", choices=ADAPTERS)
    parser.add_argument("--binary", type=Path)
    parser.add_argument("--scenario", action="append")
    parser.add_argument("--out", type=Path)
    parser.add_argument("--capture", action="store_true", help="replace selected sway fixtures")
    parser.add_argument("--capture-events", action="store_true", help="replace individual sway event fixtures")
    parser.add_argument("--command-logs", type=Path, help="directory of i3-suite *.commands.jsonl files")
    parser.add_argument("--fresh-per-scenario", action=argparse.BooleanOptionalAction,
                        default=True, help="restart the compositor before each scenario (default: enabled)")
    parser.add_argument("--timeout", type=int, default=60)
    parser.add_argument("--a", choices=ADAPTERS, default="sway")
    parser.add_argument("--b", choices=ADAPTERS, default="swayward")
    parser.add_argument("--a-binary", type=Path)
    parser.add_argument("--b-binary", type=Path)
    parser.add_argument("--seed", type=int, default=0)
    parser.add_argument("--seeds", type=int, default=5, help="fixed-seed CI budget")
    parser.add_argument("--steps", type=int, default=10)
    parser.add_argument("--save-scenarios", action="store_true",
                        help="save minimized mismatches as sway-captured scenarios")
    parser.add_argument("--triage", default="untriaged",
                        choices=("untriaged", "swayward bug", "documented deviation", "harness issue"))
    parser.add_argument("--finding", help="task ID or documented deviation name")
    parser.add_argument("--source", help="source citation supporting the triage")
    args = parser.parse_args()
    if args.mode == "differential":
        return differential_main(args)
    if args.mode == "i3-derived":
        return i3_derived_main(args, parser)
    if args.compositor is None or args.binary is None:
        parser.error("scenarios requires --compositor and --binary")
    return scenario_main(args, parser)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, ValueError) as error:
        print(f"sway-ipc-run: {error}", file=sys.stderr)
        raise SystemExit(2)
