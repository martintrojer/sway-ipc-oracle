def differential_action(adapter, text):
    before = fixture_window_count(ipc(adapter.socket, "tree"))
    if isinstance(adapter, I3Adapter) and text.startswith("exec foot --app-id="):
        ident = text.split("--app-id=", 1)[1].split(" ", 1)[0]
        text = f"exec --no-startup-id xterm -name {ident} -title {ident}"
    reply = adapter.command_reply(text)
    if (text.startswith(("exec foot --app-id=", "exec --no-startup-id xterm -name "))
            and reply and reply[0].get("success")):
        wait_for(lambda: fixture_window_count(ipc(adapter.socket, "tree")) > before,
                 "generated window")
    else:
        time.sleep(0.03)
    return reply


def differential_once(args, commands, keep_state=False):
    """Run one sequence on fresh compositors and return its first divergence."""
    with tempfile.TemporaryDirectory(prefix="sway-ipc-differential-") as directory:
        base = Path(directory)
        adapters = []
        versions = []
        logs = []
        try:
            for label, compositor, binary in (
                ("a", args.a, args.a_binary), ("b", args.b, args.b_binary)
            ):
                run_dir = base / label
                run_dir.mkdir()
                adapter_args = argparse.Namespace(binary=binary, timeout=args.timeout)
                adapter = ADAPTERS[compositor](adapter_args, run_dir)
                if compositor in DIFFERENTIAL_CONFIGS:
                    adapter.config_text = DIFFERENTIAL_CONFIGS[compositor]
                log = open(run_dir / "compositor.log", "w")
                logs.append(log)
                versions.append(adapter.start(log))
                adapters.append(adapter)
                reply = adapter.command_reply("output * mode --custom 1280x720@60Hz")
                if not reply or not reply[0].get("success"):
                    raise RuntimeError(f"could not set differential output mode: {reply}")
            rules = load_rules()
            for step, text in enumerate(commands, 1):
                replies = [differential_action(adapter, text) for adapter in adapters]
                observations = {"command": replies}
                for request in ("tree", "workspaces"):
                    observations[request] = [ipc(adapter.socket, request) for adapter in adapters]
                for request, pair in observations.items():
                    differences = compare(pair[0], pair[1], request, rules)
                    if differences:
                        result = {
                            "step": step, "command": text, "request": request,
                            "differences": differences,
                        }
                        if keep_state:
                            result["sway_state"] = {
                                "command": observations["command"][0],
                                "tree": observations["tree"][0],
                                "workspaces": observations["workspaces"][0],
                                "outputs": ipc(adapters[0].socket, "outputs"),
                            }
                        return result, versions
            return None, versions
        finally:
            for adapter in reversed(adapters):
                adapter.stop()
            for log in logs:
                log.close()


def append_regression_scenario(seed, commands, state):
    name = f"differential_seed_{seed}"
    scenario_path = ROOT / "sway-ipc/scenarios.toml"
    existing = tomllib.loads(scenario_path.read_text())["scenario"]
    if name not in {item["name"] for item in existing}:
        actions = []
        for index, text in enumerate(commands):
            if text.startswith("exec foot --app-id=fixture-diff-"):
                ident = text.split("--app-id=", 1)[1].split(" ", 1)[0]
                actions.append(f"window:{ident}")
            elif index == len(commands) - 1:
                actions.append(f"probe:{name}:{text}")
            else:
                actions.append(f"step:{text}")
        actions.append(f"capture:{name}")
        with open(scenario_path, "a") as file:
            file.write(f"\n[[scenario]]\nname = {toml_string(name)}\n")
            file.write("actions = [" + ", ".join(toml_string(item) for item in actions) + "]\n")
    has_probe = any(action.startswith(f"probe:{name}:") for action in actions)
    for request, value in state.items():
        if request == "command" and not has_probe:
            continue
        (FIXTURES / f"{name}.{request}.json").write_text(
            json.dumps(value, indent=2, sort_keys=True) + "\n"
        )
    return name


