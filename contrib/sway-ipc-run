def shape_of(tree):
    """Keep layout semantics while dropping runtime identity and geometry."""
    def node(value):
        result = {
            key: value.get(key) for key in
            ("type", "layout", "orientation", "floating", "fullscreen_mode", "sticky")
            if key in value
        }
        result["nodes"] = [node(child) for child in value.get("nodes", [])]
        result["floating_nodes"] = [node(child) for child in value.get("floating_nodes", [])]
        return result
    return node(tree)


def load_i3_logs(directory):
    records = []
    for path in sorted(directory.glob("*.commands.jsonl")):
        for line in path.read_text().splitlines():
            if line.strip():
                records.append(json.loads(line))
    return records


def settled_state(adapter):
    previous = None
    for _ in range(40):
        state = {request: ipc(adapter.socket, request)
                 for request in ("tree", "workspaces", "outputs")}
        encoded = json.dumps(state, sort_keys=True)
        if encoded == previous:
            return state
        previous = encoded
        time.sleep(0.05)
    raise RuntimeError("i3-derived state did not settle")


def replay_i3_segment(adapter, records, capture, seen, scenarios, skips):
    actions = []
    for index, record in enumerate(records, 1):
        kind, value = record["kind"], record["value"]
        if kind == "command":
            session_bound = ("[id=", "[con_id=", "[class=", "[instance=",
                             "[title=", "[window_role=", "[window_type=")
            if (any(token in value for token in session_bound)
                    or value.strip() in ("restart", "exit")
                    or "exec " in value or "bar " in value):
                skips.append({"test": record["test"], "line": record["line"],
                              "reason": f"not replayable outside the originating X11 session: {value}"})
                break
        if kind == "window":
            ident = f"fixture-i3-{len(actions) + 1}"
            adapter.open_window(ident)
            time.sleep(0.15)
            actions.append({"kind": "window", "value": ident})
        elif kind == "command":
            adapter.command_reply(value)
            actions.append({"kind": "command", "value": value})
        else:
            continue
        try:
            state = settled_state(adapter)
        except OSError as error:
            skips.append({"test": record["test"], "line": record["line"],
                          "reason": f"replay terminated the compositor: {error}"})
            break
        shape = json.dumps(shape_of(state["tree"]), sort_keys=True, separators=(",", ":"))
        digest = hashlib.sha256(shape.encode()).hexdigest()[:16]
        if digest in seen:
            continue
        seen.add(digest)
        scenario = {
            "name": digest,
            "provenance": {"test": record["test"], "line": record["line"]},
            "actions": copy.deepcopy(actions),
        }
        scenarios.append(scenario)
        if capture:
            (I3_DERIVED / f"{digest}.json").write_text(
                json.dumps(state, sort_keys=True, separators=(",", ":")) + "\n"
            )


def i3_derived_main(args, parser):
    if args.binary is None or args.compositor is None:
        parser.error("i3-derived requires --compositor and --binary")
    if args.capture and args.compositor != "sway":
        parser.error("i3-derived capture is restricted to sway")
    manifest_path = I3_DERIVED / "scenarios.json"
    if args.capture:
        if args.command_logs is None:
            parser.error("i3-derived --capture requires --command-logs")
        I3_DERIVED.mkdir(parents=True, exist_ok=True)
        for path in I3_DERIVED.glob("*.json"):
            path.unlink()
        records = load_i3_logs(args.command_logs)
        scenarios, skips, seen, segment, segments = [], [], set(), [], []
        for record in records:
            if record["kind"] == "reset":
                if segment:
                    segments.append(segment)
                    segment = []
            else:
                segment.append(record)
        if segment:
            segments.append(segment)
        for segment in segments:
            with tempfile.TemporaryDirectory(prefix="sway-ipc-i3-derived-") as directory:
                adapter = ADAPTERS["sway"](args, Path(directory))
                with open(Path(directory) / "compositor.log", "w") as log:
                    try:
                        adapter.start(log)
                        replay_i3_segment(adapter, segment, True, seen, scenarios, skips)
                    finally:
                        adapter.stop()
        manifest = {
            "description": "States reached by i3's unchanged tests, captured from sway 1.12",
            "scenarios": scenarios, "skips": skips,
        }
        manifest_path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
        print(f"captured {len(scenarios)} distinct shapes; skipped {len(skips)} sequences")
        return 0

    manifest = json.loads(manifest_path.read_text())
    scenarios = manifest["scenarios"]
    if args.scenario:
        unknown = set(args.scenario) - {item["name"] for item in scenarios}
        if unknown:
            raise RuntimeError("unknown i3-derived scenarios: " + ", ".join(sorted(unknown)))
        scenarios = [item for item in scenarios if item["name"] in args.scenario]
    rules, rows = load_rules(), []
    for scenario in scenarios:
        with tempfile.TemporaryDirectory(prefix="sway-ipc-i3-derived-") as directory:
            adapter = ADAPTERS[args.compositor](args, Path(directory))
            with open(Path(directory) / "compositor.log", "w") as log:
                try:
                    version_reply = adapter.start(log)
                    for action in scenario["actions"]:
                        if action["kind"] == "window":
                            adapter.open_window(action["value"])
                            time.sleep(0.15)
                        else:
                            adapter.command_reply(action["value"])
                    actual = settled_state(adapter)
                finally:
                    adapter.stop()
        expected = json.loads((I3_DERIVED / f"{scenario['name']}.json").read_text())
        for request in ("tree", "workspaces", "outputs"):
            differences = compare(expected[request], actual[request], request, rules)
            rows.append({"scenario": f"i3-derived/{scenario['name']}", "request": request,
                         "verdict": "mismatch" if differences else "match",
                         "differences": differences})
    version, commit = adapter.version_details(version_reply)
    out = args.out or ROOT / "sway-ipc/results" / f"{PINS['snapshot'][args.compositor]}-i3-derived.toml"
    counts, _ = write_results(out, args.compositor, version, commit, rows, rules,
                              "fresh compositor per derived i3 state")
    print("; ".join(f"{key}: {counts[key]}" for key in counts))
    return bool(counts.get("mismatch", 0))


def store_random_object(objects, value):
    """Add one canonical JSON value to a content-addressed object map."""
    encoded = json.dumps(value, sort_keys=True, separators=(",", ":"))
    digest = hashlib.sha256(encoded.encode()).hexdigest()[:16]
    objects.setdefault(digest, encoded)
    return digest

def random_result_rows(seed, commands, expected, actual, rules):
    """Return the first per-step divergence, or one matching seed row."""
    for index, (left, right) in enumerate(zip(expected, actual), 1):
        for request in ("command", "tree", "workspaces"):
            differences = compare(left[request], right[request], request, rules)
            if differences:
                return [{"seed": seed, "verdict": "mismatch", "step": index,
                         "request": request, "commands": commands[:index],
                         "differences": differences}]
    if len(expected) != len(actual):
        return [{"seed": seed, "verdict": "mismatch", "step": len(actual) + 1,
                 "request": "sequence", "commands": commands[:len(actual) + 1],
                 "differences": [f"$sequence: length {len(expected)} != {len(actual)}"]}]
    return [{"seed": seed, "verdict": "match"}]

