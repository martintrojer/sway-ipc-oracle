def write_random_results(path, args, version, commit, rows):
    counts = {key: sum(row["verdict"] == key for row in rows)
              for key in ("match", "mismatch", "not applicable")}
    grouped = []
    for row in rows:
        if row["verdict"] == "match":
            grouped.append(row)
            continue
        key = (tuple(row["commands"]), row["request"], tuple(row["differences"]))
        existing = next((item for item in grouped if item.get("key") == key), None)
        if existing:
            existing["seeds"].append(row["seed"])
        else:
            grouped.append({**row, "key": key, "seeds": [row["seed"]]})
    rules = load_rules()
    lines = [
        "# Generated by contrib/sway-ipc-run random.",
        "# One row is one seed. Mismatches show the shortest captured prefix ending at",
        "# the first divergent request; identical reproducers are grouped by seed.", "",
        "[run]", f"compositor = {toml_string(args.compositor)}",
        f"version = {toml_string(version)}", f"commit = {toml_string(commit)}",
        f"oracle_commit = {toml_string(subprocess.check_output(['git', '-C', ROOT, 'rev-parse', 'HEAD'], text=True).strip())}",
        f"date = {toml_string(datetime.date.today().isoformat())}",
        'normalization = "sway-ipc/normalize.toml"',
        "normalization_rules = [" + ", ".join(toml_string(name) for name in rule_names(rules)) + "]",
        'scenario_isolation = "fresh compositor per seed"',
        f"seeds = {len(rows)}", f"steps = {args.steps}",
        *[f"{key.replace(' ', '_')} = {counts[key]}" for key in counts], "",
    ]
    for row in grouped:
        lines += ["[[result]]", f"seed = {row['seed']}",
                  f"verdict = {toml_string(row['verdict'])}"]
        if row["verdict"] == "mismatch":
            lines += ["seeds = [" + ", ".join(str(seed) for seed in row["seeds"]) + "]",
                      f"step = {row['step']}", f"request = {toml_string(row['request'])}",
                      "commands = [" + ", ".join(toml_string(x) for x in row["commands"]) + "]",
                      "differences = [" + ", ".join(toml_string(x) for x in row["differences"]) + "]"]
        lines.append("")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines))
    print("; ".join(f"{key}: {value}" for key, value in counts.items()))
    return bool(counts["mismatch"])

