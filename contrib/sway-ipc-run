def require_clean_binary(binary: Path, compositor: str) -> str:
    probe = binary.resolve().parent
    while probe != probe.parent and not (probe / ".git").exists():
        probe = probe.parent
    if not (probe / ".git").exists():
        raise RuntimeError(f"cannot find source checkout for {binary}")
    commit = subprocess.check_output(
        ["git", "-C", probe, "rev-parse", "HEAD"], text=True
    ).strip()
    description = subprocess.check_output(
        ["git", "-C", probe, "describe", "--always", "--dirty"], text=True
    ).strip()
    dirty = subprocess.check_output(
        ["git", "-C", probe, "status", "--porcelain"], text=True
    ).strip()
    if commit != PINS[compositor]:
        raise RuntimeError(
            f"{compositor} source is {commit}, expected pinned commit {PINS[compositor]}"
        )
    if dirty or description.endswith("-dirty"):
        raise RuntimeError(f"refusing to measure dirty {compositor} build ({description})")
    return commit


def reject_dirty_version(compositor: str, version: str, commit: str) -> None:
    if re.search(r"(?:-dirty|-modified)\b", version) or commit.endswith(("-dirty", "-modified")):
        raise RuntimeError(f"refusing to record dirty {compositor} build: {version}")


def generate_commands(seed, steps):
    """Return a reproducible sequence of sway command strings."""
    rng = random.Random(seed)
    commands, next_window = [
        "exec foot --app-id=fixture-diff-1 --title=fixture-diff-1 sh -c 'sleep 300'"
    ], 2
    for _ in range(max(0, steps - 1)):
        if rng.random() < 0.22:
            ident = f"fixture-diff-{next_window}"
            next_window += 1
            commands.append(
                f"exec foot --app-id={ident} --title={ident} sh -c 'sleep 300'"
            )
        else:
            commands.append(rng.choice(COMMANDS))
    return commands


def minimize_commands(commands, reproduces):
    """Delta-debug COMMANDS to a 1-minimal reproducing subsequence."""
    current, chunks = list(commands), 2
    while len(current) >= 2:
        size = (len(current) + chunks - 1) // chunks
        reduced = False
        for start in range(0, len(current), size):
            candidate = current[:start] + current[start + size:]
            if candidate and reproduces(candidate):
                current, chunks, reduced = candidate, max(chunks - 1, 2), True
                break
        if not reduced:
            if chunks >= len(current):
                break
            chunks = min(len(current), chunks * 2)
    return current


def ipc(sock_path, kind, payload=""):
    body = payload.encode()
    with socket.socket(socket.AF_UNIX) as stream:
        stream.settimeout(5)
        stream.connect(os.fspath(sock_path))
        stream.sendall(MAGIC + struct.pack("=II", len(body), TYPES[kind]) + body)
        header = recv_exact(stream, 14)
        if header[:6] != MAGIC:
            raise RuntimeError("invalid IPC magic")
        length, reply_type = struct.unpack("=II", header[6:])
        if reply_type != TYPES[kind]:
            raise RuntimeError(f"IPC type {reply_type}, expected {TYPES[kind]}")
        return json.loads(recv_exact(stream, length))


def recv_exact(stream, length):
    chunks = []
    while length:
        chunk = stream.recv(length)
        if not chunk:
            raise RuntimeError("IPC connection closed before reply")
        chunks.append(chunk)
        length -= len(chunk)
    return b"".join(chunks)


class EventSubscription:
    def __init__(self, sock_path, families=EVENTS):
        self.stream = socket.socket(socket.AF_UNIX)
        self.stream.settimeout(8)
        self.stream.connect(os.fspath(sock_path))
        body = json.dumps(families).encode()
        self.stream.sendall(MAGIC + struct.pack("=II", len(body), TYPES["subscribe"]) + body)
        header = recv_exact(self.stream, 14)
        length, reply_type = struct.unpack("=II", header[6:])
        self.reply = json.loads(recv_exact(self.stream, length))
        self.active = reply_type == TYPES["subscribe"] and self.reply.get("success")

    def checkpoint(self, sock_path, token):
        if not self.active:
            return {"subscription": self.reply}
        ipc(sock_path, "tick", token)
        events = []
        while True:
            header = recv_exact(self.stream, 14)
            length, reply_type = struct.unpack("=II", header[6:])
            event = json.loads(recv_exact(self.stream, length))
            if not reply_type & (1 << 31):
                raise RuntimeError(f"expected event, got IPC type {reply_type}")
            if event.get("payload") == token:
                return events
            events.append(event)

    def close(self):
        self.stream.close()


