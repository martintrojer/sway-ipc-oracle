#!/bin/bash
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")/.."

usage='usage: validate [reproduce {i3|sway|swayward|all} [--snapshot {i3-suite|sway-ipc}] [--shard K/N] [--out PATH]]'
if [[ ${1:-} == --help ]]; then
    echo "$usage"
    echo 'Validate the repository, or reproduce one independent snapshot in the oracle container.'
    exit 0
fi

if [[ ${1:-} == reproduce ]]; then
    mode=${2:-all}
    shift $(( $# >= 2 ? 2 : $# ))
    snapshot=all shard= out=
    while (($#)); do
        case $1 in
            --snapshot) snapshot=${2:-}; shift 2 ;;
            --shard) shard=${2:-}; shift 2 ;;
            --out) out=${2:-}; shift 2 ;;
            *) echo "$usage" >&2; exit 2 ;;
        esac
    done
    case $mode in
        i3|sway|swayward|all) ;;
        *) echo "$usage" >&2; exit 2 ;;
    esac
    case $snapshot in
        i3-suite|sway-ipc|all) ;;
        *) echo "$usage" >&2; exit 2 ;;
    esac
    [[ -z $shard || $snapshot != all ]] || snapshot=i3-suite
    [[ -z $shard || $snapshot == i3-suite ]] || { echo '--shard requires --snapshot i3-suite' >&2; exit 2; }
    [[ -z $shard || -n $out ]] || { echo '--shard requires --out' >&2; exit 2; }
    [[ $mode != all || ( -z $shard && -z $out && $snapshot == all ) ]] || {
        echo 'all does not accept snapshot output options' >&2; exit 2
    }
    [[ ${ORACLE_CONTAINER:-} == 1 ]] || {
        echo 'reproduce must run in the oracle container; see README.md' >&2
        exit 2
    }
    # Fast canaries stop a broken harness before it spends an hour producing
    # measurements. The post-run checks below also protect direct full runs.
    canaries=(003-ipc.t 115-ipc-workspaces.t 126-regress-close.t 134-invalid-command.t 139-ws-numbers.t)
    sanity_check() {
        compositor=$1
        python3 - "$compositor" <<'PY'
import sys, tomllib
from pathlib import Path

compositor = sys.argv[1]
name = tomllib.load(open("pins.toml", "rb"))["snapshot"][compositor]
result = tomllib.load(open(f"i3/results/{name}.toml", "rb"))
files = result["files"]
canaries = {
    "003-ipc.t": 1,
    "115-ipc-workspaces.t": 9,
    "126-regress-close.t": 1,
    "134-invalid-command.t": 1,
    "139-ws-numbers.t": 8,
}
for name, assertions in canaries.items():
    entry = files[name]
    expected = (assertions, 0, 0)
    actual = (entry.get("pass", 0), entry.get("skip", 0),
              entry.get("fail", 0) + entry.get("unreached", 0))
    if actual != expected:
        raise SystemExit(
            f"{compositor} harness sanity failed: {name} is {actual}, expected {expected}"
        )
zero_pass = sum(
    entry.get("pass", 0) == 0 and not entry.get("flaky")
    for entry in files.values()
)
if zero_pass > 60:
    raise SystemExit(
        f"{compositor} harness sanity failed: {zero_pass} files have zero passes (limit 60)"
    )
diagnostics = Path(f"target/i3-suite/{compositor}")
needles = ("No such atom (I3_SOCKET_PATH)", "no free X11 display")
for path in diagnostics.rglob("*"):
    if path.is_file() and "159-socketpaths.t" not in path.parts and path.name != "159-socketpaths.t.tap":
        text = path.read_text(errors="replace")
        for needle in needles:
            if needle in text:
                raise SystemExit(f"{compositor} harness sanity failed: {needle} in {path}")
print(f"{compositor} harness sanity passed ({zero_pass} zero-pass files)")
PY
    }
    binary_for() {
        case $1 in
            i3) echo "$I3_BINARY" ;;
            sway) echo "$SWAY_BINARY" ;;
            swayward) echo "$SWAYWARD_BINARY" ;;
        esac
    }
    run_i3_suite() {
        compositor=$1 binary=$(binary_for "$1")
        parallel=1
        [[ $compositor == i3 ]] && parallel=4
        preflight=(--compositor "$compositor" --binary "$binary" --i3src "$I3SRC"
                   --i3build "$I3BUILD" --parallel "$parallel" --require-complete)
        [[ -z $out ]] || preflight+=(--work-dir "${out}.canary-work")
        ./contrib/i3-suite-run "${preflight[@]}" "${canaries[@]}"
        # i3's complete-run.pl names output directories at one-second resolution.
        sleep 1
        args=(--compositor "$compositor" --binary "$binary" --i3src "$I3SRC"
              --i3build "$I3BUILD" --parallel "$parallel")
        [[ -z $shard ]] || args+=(--shard "$shard" --work-dir "${out}.work")
        [[ -z $out ]] || args+=(--out "$out")
        ./contrib/i3-suite-run "${args[@]}"
        [[ -n $shard || -n $out ]] || sanity_check "$compositor"
    }
    snapshot_name() {
        python3 -c 'import sys, tomllib; print(tomllib.load(open("pins.toml", "rb"))["snapshot"][sys.argv[1]])' "$1"
    }
    run_sway_ipc() {
        compositor=$1 binary=$(binary_for "$1")
        result=${out:-sway-ipc/results/$(snapshot_name "$compositor").toml}
        ./contrib/sway-ipc-run --compositor "$compositor" --binary "$binary" \
            --out "$result" || [[ $? == 1 ]]
    }
    run_one() {
        [[ $snapshot == sway-ipc ]] || run_i3_suite "$1"
        [[ $snapshot == i3-suite ]] || run_sway_ipc "$1"
    }
    if [[ $mode == all ]]; then
        run_one i3
        run_one sway
        run_one swayward
    else
        run_one "$mode"
    fi
    exit
fi

(($# == 0)) || { echo 'usage: validate [reproduce {i3|sway|swayward|all}]' >&2; exit 2; }

python3 - <<'PY'
import re
from pathlib import Path

root = Path("contrib")
readme = (root / "README.md").read_text()
listed = set(re.findall(r"^\| `([^`/]+)` \|", readme, re.M))
actual = {
    path.name
    for path in root.iterdir()
    if path.is_file() and path.name != "README.md"
}
missing = sorted(listed - actual)
unlisted = sorted(actual - listed)
if missing or unlisted:
    for name in missing:
        print(f"contrib inventory lists missing file: {name}")
    for name in unlisted:
        print(f"contrib file is not inventoried: {name}")
    raise SystemExit(1)
PY

shopt -s nullglob
i3_results=(i3/results/*.toml)
sway_ipc_results=(sway-ipc/results/*.toml)
((${#i3_results[@]} + ${#sway_ipc_results[@]})) || { echo "no result files" >&2; exit 1; }
status=0
for result in "${i3_results[@]}"; do
    ./contrib/coverage-report "$result" --check || status=1
done
for result in "${sway_ipc_results[@]}"; do
    python3 -c 'import sys, tomllib; tomllib.load(open(sys.argv[1], "rb"))' "$result" || status=1
done
((status == 0)) || exit "$status"
python3 - <<'PY'
import re, tomllib
from pathlib import Path

pins = tomllib.load(open("pins.toml", "rb"))
names = pins["snapshot"]
# Every result is one compositor at one version, named from pins.toml.
for oracle in ("i3", "sway-ipc"):
    for path in sorted(Path(oracle, "results").glob("*.toml")):
        stem = path.stem.removesuffix("-i3-derived")
        compositor = next((c for c, n in names.items() if n == stem), None)
        if compositor is None:
            raise SystemExit(f"{path}: name is not a snapshot in pins.toml [snapshot]")
        run = tomllib.load(path.open("rb")).get("run", {})
        commit = str(run.get("commit", ""))
        if run.get("compositor") != compositor or not pins[compositor].startswith(commit[:8] or "?"):
            raise SystemExit(f"{path}: [run] does not match snapshot {stem} (compositor/commit)")
for path in Path("i3/results").iterdir():
    if path.suffix != ".toml":
        raise SystemExit(f"{path}: only snapshot TOML files belong in results/")

# The README snapshot table quotes each snapshot's figures, all columns together.
readme = Path("README.md").read_text()
table = {}
for line in readme.splitlines():
    cells = [c.strip() for c in line.strip().strip("|").split("|")]
    if len(cells) == 5 and cells[0].startswith("`") and cells[0].strip("`") in names.values():
        table[cells[0].strip("`")] = cells
    elif len(cells) == 5 and cells[1] == "not yet measured" and cells[2:] != ["—", "—", "—"]:
        raise SystemExit(f"README placeholder row for {cells[0]} must not carry figures")
def counts(entry):
    return entry.get("pass", 0), entry.get("skip", 0), entry.get("fail", 0) + entry.get("unreached", 0)
for compositor, name in names.items():
    doc = tomllib.load(open(f"i3/results/{name}.toml", "rb"))
    rows = [counts(e) for e in doc["files"].values() if not e.get("flaky")]
    suite = "/".join(f"{n:,}" for n in (sum(r[i] for r in rows) for i in range(3)))
    flaky = str(sum(1 for e in doc["files"].values() if e.get("flaky")))
    ipc = tomllib.load(open(f"sway-ipc/results/{name}.toml", "rb"))["run"]
    fields = "/".join(str(n) for n in (ipc.get("match", 0), ipc.get("mismatch", ipc.get("differs", 0)), ipc.get("not_applicable", 0)))
    commit = f"`{pins[compositor][:8]}`"
    expected = [f"`{name}`", suite, flaky, fields, commit]
    if table.get(name) != expected:
        raise SystemExit(f"README snapshot row for {name} should be: | {' | '.join(expected)} |")
PY
PYTHONPYCACHEPREFIX="${TMPDIR:-/tmp}/sway-ipc-oracle-pycache" python3 -m py_compile contrib/sway-ipc-run
if grep -En 'endswith\("\.(percent|rect)"\)|get\("floating"\) *==' contrib/sway-ipc-run; then
    echo "comparator field exemptions must be declared in sway-ipc/normalize.toml" >&2
    exit 1
fi
python3 -c 'import tomllib; tomllib.load(open("sway-ipc/scenarios.toml", "rb")); tomllib.load(open("sway-ipc/normalize.toml", "rb")); tomllib.load(open("sway-ipc/applicability.toml", "rb"))'
python3 - <<'PY'
import json
from pathlib import Path
root = Path("sway-ipc/i3-derived")
manifest = json.loads((root / "scenarios.json").read_text())
names = [row["name"] for row in manifest["scenarios"]]
assert len(names) == len(set(names))
assert set(names) == {path.stem for path in root.glob("*.json") if path.name != "scenarios.json"}
for row in manifest["scenarios"]:
    assert row["provenance"]["test"].endswith(".t") and row["provenance"]["line"] > 0
    capture = json.loads((root / f"{row['name']}.json").read_text())
    assert set(capture) == {"tree", "workspaces", "outputs"}
PY
PYTHONPYCACHEPREFIX="${TMPDIR:-/tmp}/sway-ipc-oracle-pycache" ./contrib/tests/sway-ipc-applicability
./contrib/i3-suite-run --self-test
./contrib/tests/sway-ipc-reap-clients

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
git clone --quiet --filter=blob:none --no-checkout https://github.com/swaywm/sway.git "$work/sway"
git -C "$work/sway" checkout --quiet "$(python3 -c 'import json; print(json.load(open("sway-ipc/fixtures/schema-version.json"))["commit"])')"
./contrib/check-sway-fixture-schema "$work/sway"
