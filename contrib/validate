#!/bin/bash
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")/.."

if [[ ${1:-} == --help ]]; then
    echo 'usage: validate [reproduce {i3|sway|swayward|all}]'
    echo 'Validate the repository, or reproduce results in the oracle container.'
    exit 0
fi

if [[ ${1:-} == reproduce ]]; then
    mode=${2:-all}
    (($# <= 2)) || { echo 'usage: validate reproduce {i3|sway|swayward|all}' >&2; exit 2; }
    case $mode in
        i3|sway|swayward|all) ;;
        *) echo 'usage: validate reproduce {i3|sway|swayward|all}' >&2; exit 2 ;;
    esac
    [[ ${ORACLE_CONTAINER:-} == 1 ]] || {
        echo 'reproduce must run in the oracle container; see README.md' >&2
        exit 2
    }
    sanity_check() {
        compositor=$1
        python3 - "$compositor" <<'PY'
import sys, tomllib
from pathlib import Path

compositor = sys.argv[1]
result = tomllib.load(open(f"i3/results/{compositor}.toml", "rb"))
files = result["files"]
canaries = {
    "i3": {"001-tile.t": (3, 0, 0), "122-split.t": (41, 0, 0)},
    "sway": {"001-tile.t": (3, 0, 0), "112-floating-resize.t": (15, 0, 0)},
    "swayward": {"001-tile.t": (3, 0, 0), "122-split.t": (41, 0, 0)},
}
for name, expected in canaries[compositor].items():
    entry = files[name]
    actual = (entry.get("pass", 0), entry.get("skip", 0),
              entry.get("fail", 0) + entry.get("unreached", 0))
    if actual != expected:
        raise SystemExit(
            f"{compositor} harness sanity failed: {name} is {actual}, expected {expected}"
        )
zero_pass = sum(entry.get("pass", 0) == 0 for entry in files.values())
if zero_pass > 60:
    raise SystemExit(
        f"{compositor} harness sanity failed: {zero_pass} files have zero passes (limit 60)"
    )
diagnostics = Path(f"target/i3-suite/{compositor}")
needles = ("No such atom (I3_SOCKET_PATH)", "no free X11 display")
for path in diagnostics.rglob("*"):
    if path.is_file():
        text = path.read_text(errors="replace")
        for needle in needles:
            if needle in text:
                raise SystemExit(f"{compositor} harness sanity failed: {needle} in {path}")
print(f"{compositor} harness sanity passed ({zero_pass} zero-pass files)")
PY
    }
    run_one() {
        compositor=$1
        case $compositor in
            i3) binary=$I3_BINARY ;;
            sway) binary=$SWAY_BINARY ;;
            swayward) binary=$SWAYWARD_BINARY ;;
        esac
        parallel=1
        [[ $compositor == i3 ]] && parallel=4
        ./contrib/i3-suite-run --compositor "$compositor" --binary "$binary" \
            --i3src "$I3SRC" --i3build "$I3BUILD" --parallel "$parallel"
        sanity_check "$compositor"
        ./contrib/sway-ipc-run --compositor "$compositor" --binary "$binary" \
            --out "sway-ipc/results/$compositor.toml" || [[ $? == 1 ]]
    }
    if [[ $mode == all ]]; then
        run_one i3
        run_one sway
        run_one swayward
        ./contrib/sway-ipc-run differential --a-binary "$SWAY_BINARY" \
            --b-binary "$SWAYWARD_BINARY" --seeds 200 --steps 30 || [[ $? == 1 ]]
    else
        run_one "$mode"
    fi
    exit
fi

(($# == 0)) || { echo 'usage: validate [reproduce {i3|sway|swayward|all}]' >&2; exit 2; }

python3 - <<'PY'
import re
from pathlib import Path

root = Path("contrib")
readme = (root / "README.md").read_text()
listed = set(re.findall(r"^\| `([^`/]+)` \|", readme, re.M))
actual = {
    path.name
    for path in root.iterdir()
    if path.is_file() and path.name != "README.md"
}
missing = sorted(listed - actual)
unlisted = sorted(actual - listed)
if missing or unlisted:
    for name in missing:
        print(f"contrib inventory lists missing file: {name}")
    for name in unlisted:
        print(f"contrib file is not inventoried: {name}")
    raise SystemExit(1)
PY

shopt -s nullglob
i3_results=(i3/results/*.toml)
sway_ipc_results=(sway-ipc/results/*.toml)
((${#i3_results[@]} + ${#sway_ipc_results[@]})) || { echo "no result files" >&2; exit 1; }
status=0
for result in "${i3_results[@]}"; do
    ./contrib/coverage-report "$result" --check || status=1
done
for result in "${sway_ipc_results[@]}"; do
    python3 -c 'import sys, tomllib; tomllib.load(open(sys.argv[1], "rb"))' "$result" || status=1
done
python3 - <<'PY' || status=1
import tomllib
from pathlib import Path

measurement_path = Path("sway-ipc/results/differential-swayward.toml")
classification_path = Path("sway-ipc/classifications/differential-swayward.toml")
measurement = tomllib.load(measurement_path.open("rb"))
classification = tomllib.load(classification_path.open("rb"))

def key(row):
    return (tuple(row.get("commands", [])), row.get("request"), tuple(row.get("differences", [])))

measured = {key(row): row for row in measurement["result"] if row["verdict"] == "mismatch"}
classified = {key(row): row for row in classification.get("classification", [])}
for missing in measured.keys() - classified.keys():
    print(f"differential mismatch has no classification: {missing}")
for stale in classified.keys() - measured.keys():
    print(f"differential classification points at no mismatch: {stale}")
for row in classified.values():
    if row.get("triage") == "untriaged":
        print(f"differential classification remains untriaged: {key(row)}")
if measured.keys() != classified.keys() or any(row.get("triage") == "untriaged" for row in classified.values()):
    raise SystemExit(1)
PY
((status == 0)) || exit "$status"
python3 - <<'PY'
import tomllib
from pathlib import Path

readme = Path("README.md").read_text()
docs = {name: tomllib.load(open(f"i3/results/{name}.toml", "rb")) for name in ("i3", "sway", "swayward")}
def counts(entry):
    return entry.get("pass", 0), entry.get("skip", 0), entry.get("fail", 0) + entry.get("unreached", 0)
def totals(doc):
    rows = [counts(entry) for entry in doc["files"].values() if not entry.get("flaky")]
    return tuple(sum(row[i] for row in rows) for i in range(3))
for name, doc in docs.items():
    expected = "/".join(f"{number:,}" for number in totals(doc))
    if f"{name} **{expected}**" not in readme:
        raise SystemExit(f"README i3-suite summary for {name} is not {expected}")
for filename in docs["i3"]["files"]:
    expected = " | ".join(
        "flaky" if docs[compositor]["files"][filename].get("flaky")
        else "/".join(map(str, counts(docs[compositor]["files"][filename])))
        for compositor in ("i3", "sway", "swayward")
    )
    if f"| `{filename}` | {expected} |" not in readme:
        raise SystemExit(f"README i3-suite row is stale: {filename}")
PY
PYTHONPYCACHEPREFIX="${TMPDIR:-/tmp}/sway-ipc-oracle-pycache" python3 -m py_compile contrib/sway-ipc-run
if grep -En 'endswith\("\.(percent|rect)"\)|get\("floating"\) *==' contrib/sway-ipc-run; then
    echo "comparator field exemptions must be declared in sway-ipc/normalize.toml" >&2
    exit 1
fi
python3 -c 'import tomllib; tomllib.load(open("sway-ipc/scenarios.toml", "rb")); tomllib.load(open("sway-ipc/normalize.toml", "rb")); tomllib.load(open("sway-ipc/applicability.toml", "rb"))'
python3 - <<'PY'
import json
from pathlib import Path
root = Path("sway-ipc/i3-derived")
manifest = json.loads((root / "scenarios.json").read_text())
names = [row["name"] for row in manifest["scenarios"]]
assert len(names) == len(set(names))
assert set(names) == {path.stem for path in root.glob("*.json") if path.name != "scenarios.json"}
for row in manifest["scenarios"]:
    assert row["provenance"]["test"].endswith(".t") and row["provenance"]["line"] > 0
    capture = json.loads((root / f"{row['name']}.json").read_text())
    assert set(capture) == {"tree", "workspaces", "outputs"}
PY
PYTHONPYCACHEPREFIX="${TMPDIR:-/tmp}/sway-ipc-oracle-pycache" ./contrib/tests/sway-ipc-applicability
./contrib/i3-suite-run --self-test

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
git clone --quiet --filter=blob:none --no-checkout https://github.com/swaywm/sway.git "$work/sway"
git -C "$work/sway" checkout --quiet "$(python3 -c 'import json; print(json.load(open("sway-ipc/fixtures/schema-version.json"))["commit"])')"
./contrib/check-sway-fixture-schema "$work/sway"
