#!/bin/bash
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")/.."

if [[ ${1:-} == --help ]]; then
    echo 'usage: validate'
    echo 'Run the repository checks, tool self-tests, inventory check, and pinned sway schema comparison.'
    exit 0
fi
(($# == 0)) || { echo 'usage: validate' >&2; exit 2; }

python3 - <<'PY'
import re
from pathlib import Path

root = Path("contrib")
readme = (root / "README.md").read_text()
listed = set(re.findall(r"^\| `([^`/]+)` \|", readme, re.M))
actual = {
    path.name
    for path in root.iterdir()
    if path.is_file() and path.name != "README.md"
}
missing = sorted(listed - actual)
unlisted = sorted(actual - listed)
if missing or unlisted:
    for name in missing:
        print(f"contrib inventory lists missing file: {name}")
    for name in unlisted:
        print(f"contrib file is not inventoried: {name}")
    raise SystemExit(1)
PY

shopt -s nullglob
i3_results=(i3/results/*.toml)
sway_ipc_results=(sway-ipc/results/*.toml)
((${#i3_results[@]} + ${#sway_ipc_results[@]})) || { echo "no result files" >&2; exit 1; }
status=0
for result in "${i3_results[@]}"; do
    ./contrib/coverage-report "$result" --check || status=1
done
for result in "${sway_ipc_results[@]}"; do
    python3 -c 'import sys, tomllib; tomllib.load(open(sys.argv[1], "rb"))' "$result" || status=1
done
((status == 0)) || exit "$status"
python3 - <<'PY'
import re, tomllib
from pathlib import Path
readme = Path("README.md").read_text()
docs = {name: tomllib.load(open(f"i3/results/{name}.toml", "rb")) for name in ("i3", "sway", "swayward")}
def counts(entry):
    return entry.get("pass", 0), len(entry.get("skip", [])), entry.get("fail", 0) + entry.get("unreached", 0)
def totals(doc):
    rows = [counts(entry) for entry in doc["files"].values()]
    return tuple(sum(row[i] for row in rows) for i in range(3))
for name, doc in docs.items():
    expected = "/".join(f"{n:,}" for n in totals(doc))
    if f"{name} **{expected}**" not in readme:
        raise SystemExit(f"README i3-suite summary for {name} is not {expected}")
    claim = f"All {name} failures now carry a verified family classification."
    unverified = [
        filename
        for filename, entry in doc["files"].items()
        if (entry.get("fail", 0) or entry.get("unreached", 0))
        and entry.get("reason_verified") is not True
    ]
    if claim in readme and unverified:
        raise SystemExit(
            f"README claims all {name} failures are verified, but {len(unverified)} rows are not"
        )
for name in docs["i3"]["files"]:
    expected = " | ".join("/".join(map(str, counts(docs[c]["files"][name]))) for c in ("i3", "sway", "swayward"))
    if f"| `{name}` | {expected} |" not in readme:
        raise SystemExit(f"README i3-suite row is stale: {name}")

wayland_docs = {name: docs[name] for name in ("sway", "swayward")}
for compositor, doc in wayland_docs.items():
    for filename, entry in doc["files"].items():
        if "fake-outputs->headless-outputs" in entry.get("adapted", []):
            reasons = {entry.get("reason")} | {skip.get("reason") for skip in entry.get("skip", [])}
            if "i3_fake_outputs" in reasons:
                raise SystemExit(
                    f"{compositor} {filename} translates fake outputs but retains an i3_fake_outputs skip"
                )
boundary_families = {
    family
    for doc in wayland_docs.values()
    for family in doc.get("families", {})
    if family.endswith("_boundary")
}
for family in sorted(boundary_families):
    verdicts = {}
    for compositor, doc in wayland_docs.items():
        if family not in doc.get("families", {}):
            verdicts[compositor] = "missing"
            continue
        entries = [entry for entry in doc["files"].values() if entry.get("reason") == family]
        kinds = {
            "fail"
            if entry.get("fail", 0) or entry.get("unreached", 0)
            else "skip"
            if entry.get("skip")
            else "empty"
            for entry in entries
        }
        verdicts[compositor] = ",".join(sorted(kinds)) if kinds else "unused"
    if len(set(verdicts.values())) != 1 or next(iter(verdicts.values())) not in {"fail", "skip"}:
        detail = ", ".join(f"{name}={verdict}" for name, verdict in verdicts.items())
        raise SystemExit(f"boundary family {family} has inconsistent verdicts: {detail}")
PY
PYTHONPYCACHEPREFIX="${TMPDIR:-/tmp}/sway-ipc-oracle-pycache" python3 -m py_compile contrib/sway-ipc-run
if grep -En 'endswith\("\.(percent|rect)"\)|get\("floating"\) *==' contrib/sway-ipc-run; then
    echo "comparator field exemptions must be declared in sway-ipc/normalize.toml" >&2
    exit 1
fi
python3 -c 'import tomllib; tomllib.load(open("sway-ipc/scenarios.toml", "rb")); tomllib.load(open("sway-ipc/normalize.toml", "rb")); tomllib.load(open("sway-ipc/applicability.toml", "rb"))'
python3 - <<'PY'
import json
from pathlib import Path
root = Path("sway-ipc/i3-derived")
manifest = json.loads((root / "scenarios.json").read_text())
names = [row["name"] for row in manifest["scenarios"]]
assert len(names) == len(set(names))
assert set(names) == {path.stem for path in root.glob("*.json") if path.name != "scenarios.json"}
for row in manifest["scenarios"]:
    assert row["provenance"]["test"].endswith(".t") and row["provenance"]["line"] > 0
    capture = json.loads((root / f"{row['name']}.json").read_text())
    assert set(capture) == {"tree", "workspaces", "outputs"}
PY
PYTHONPYCACHEPREFIX="${TMPDIR:-/tmp}/sway-ipc-oracle-pycache" ./contrib/tests/sway-ipc-applicability
./contrib/i3-suite-run --self-test

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
git clone --quiet --filter=blob:none --no-checkout https://github.com/swaywm/sway.git "$work/sway"
git -C "$work/sway" checkout --quiet "$(python3 -c 'import json; print(json.load(open("sway-ipc/fixtures/schema-version.json"))["commit"])')"
./contrib/check-sway-fixture-schema "$work/sway"
