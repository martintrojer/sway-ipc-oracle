#!/bin/bash
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")/.."

shopt -s nullglob
i3_results=(i3/results/*.toml)
sway_ipc_results=(sway-ipc/results/*.toml)
((${#i3_results[@]} + ${#sway_ipc_results[@]})) || { echo "no result files" >&2; exit 1; }
for result in "${i3_results[@]}"; do
    ./contrib/coverage-report "$result" --check
done
for result in "${sway_ipc_results[@]}"; do
    python3 -c 'import sys, tomllib; tomllib.load(open(sys.argv[1], "rb"))' "$result"
done
PYTHONPYCACHEPREFIX="${TMPDIR:-/tmp}/sway-ipc-oracle-pycache" python3 -m py_compile contrib/sway-ipc-run
python3 -c 'import tomllib; tomllib.load(open("sway-ipc/scenarios.toml", "rb")); tomllib.load(open("sway-ipc/normalize.toml", "rb"))'

tap_report=$(printf '%s\n' 'ok 1 - pass' 'ok 2 # SKIP premise' 'not ok 3 - fail' '1..3' | ./contrib/tap-count)
grep -Fq 'stream 1: 3 checks, 1 ok, 1 skip, 1 not ok  (authoritative)' <<<"$tap_report"
grep -Fq 'report: 1 pass; 1 skip; 1 fail' <<<"$tap_report"
echo 'tap-count sanity check passed'

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
git clone --quiet --filter=blob:none --no-checkout https://github.com/swaywm/sway.git "$work/sway"
git -C "$work/sway" checkout --quiet "$(python3 -c 'import json; print(json.load(open("sway-ipc/fixtures/schema-version.json"))["commit"])')"
./contrib/check-sway-fixture-schema "$work/sway"
